workspace "Taller2PSP" "Modelo C4 formal del sistema web autoadaptativo MAPE-K" {

	model {
		usuario = person "Usuario final" "Interactua con el sistema a traves de un navegador web para consultar contenido educativo adaptativo."
		carga = softwareSystem "Herramienta de carga" "Emite solicitudes HTTP de prueba para observar la respuesta autoadaptativa del sistema."

		sistema = softwareSystem "Sistema web autoadaptativo de gestion de contenidos" "Regula dinamicamente la presentacion del contenido segun la demanda observada." {
			webApp = container "Aplicacion web" "Contenedor ejecutable en Java 17 y Javalin que concentra la exposicion HTTP, la orquestacion MAPE-K y el renderizado adaptativo." "Java 17, Javalin" {
				webServer = component "WebServer" "Configura el servidor HTTP, publica recursos estaticos y registra el enrutamiento de la aplicacion." "Java"
				controller = component "ContentController" "Define los endpoints HTTP del sistema y coordina la ejecucion del ciclo adaptativo." "Java"
				mapeFacade = component "MapeCycleFacade" "Encapsula una iteracion completa del ciclo MAPE-K." "Java"
				monitor = component "Monitor" "Observa y registra la carga de solicitudes." "Java"
				analyzer = component "Analyzer" "Evalua la demanda a partir del estado observado y los umbrales configurados." "Java"
				planner = component "Planner" "Selecciona el modo de presentacion apropiado segun la demanda detectada." "Java"
				executor = component "Executor" "Materializa la decision de adaptacion sobre la base de conocimiento." "Java"
				knowledgeBase = component "KnowledgeBase" "Repositorio centralizado de estado y configuracion, implementado como singleton sincronizado." "Java"
				contentService = component "ContentService" "Selecciona la estrategia de presentacion y produce la representacion HTML final." "Java"
				strategyInterface = component "ContentPresentationStrategy" "Contrato comun para las estrategias de presentacion." "Java"
				multimediaStrategy = component "MultimediaPresentationStrategy" "Presentacion integral con texto, imagenes y videos." "Java"
				restrictedStrategy = component "RestrictedPresentationStrategy" "Presentacion intermedia con texto e imagenes." "Java"
				textStrategy = component "TextPresentationStrategy" "Presentacion minima orientada a alta demanda." "Java"

				webServer -> controller "Registra las rutas HTTP"
				controller -> mapeFacade "Ejecuta el ciclo MAPE-K ante una solicitud a /content"
				controller -> contentService "Genera la vista adaptada segun el modo activo"
				controller -> knowledgeBase "Consulta el estado actual y reinicia la simulacion"

				mapeFacade -> monitor "Registra la solicitud"
				mapeFacade -> analyzer "Determina el nivel de demanda"
				mapeFacade -> planner "Propone el modo de presentacion"
				mapeFacade -> executor "Aplica la adaptacion"
				mapeFacade -> knowledgeBase "Recupera el modo activo resultante"

				monitor -> knowledgeBase "Incrementa el contador de solicitudes"
				analyzer -> knowledgeBase "Lee el contador y los umbrales de adaptacion"
				executor -> knowledgeBase "Actualiza el modo de presentacion"

				contentService -> strategyInterface "Selecciona la estrategia concreta"
				multimediaStrategy -> strategyInterface "Realiza la presentacion multimedia"
				restrictedStrategy -> strategyInterface "Realiza la presentacion restringida"
				textStrategy -> strategyInterface "Realiza la presentacion textual"
			}
		}

		usuario -> sistema "Consume el contenido adaptativo" "HTTP"
		carga -> sistema "Genera carga para inducir cambios de modo" "HTTP"
	}

	views {
		systemContext sistema {
			include usuario
			include carga
			include sistema
			autolayout lr
		}

		container sistema {
			include usuario
			include carga
			include webApp
			autolayout lr
		}

		component webApp {
			include *
			autolayout lr
		}

		styles {
			element "Person" {
				shape Person
				background "#2A6F97"
				color "#FFFFFF"
			}

			element "Software System" {
				background "#0B3954"
				color "#FFFFFF"
			}

			element "Container" {
				background "#D9EAF4"
				color "#102A43"
			}

			element "Component" {
				background "#F7F3E9"
				color "#3E2F1C"
			}
		}
	}
}