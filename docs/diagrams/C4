BASE HECHA CON IA

workspace "Taller2PSP" "Modelo C4 del sistema MAPE-K de gestión de contenidos" {

	model {
		usuario = person "Usuario final" "Accede al contenido adaptativo desde un navegador web."

		sistema = softwareSystem "Sistema MAPE-K de gestión de contenidos" "Adapta la presentación del contenido según la demanda detectada." {
			webApp = container "Aplicación web" "Servidor HTTP con Javalin que expone los endpoints y orquesta la adaptación." "Java 17, Javalin" {
				controller = component "ContentController" "Expone /, /content, /status y /reset." "Java"
				webServer = component "WebServer" "Configura Javalin, registra rutas y crea el controlador." "Java"
				contentService = component "ContentService" "Selecciona la estrategia de presentación y renderiza el contenido." "Java"
				mapeFacade = component "MapeCycleFacade" "Orquesta Monitor, Analyzer, Planner y Executor." "Java"
				monitor = component "Monitor" "Registra solicitudes en la base de conocimiento." "Java"
				analyzer = component "Analyzer" "Clasifica la demanda usando el contador y los umbrales." "Java"
				planner = component "Planner" "Convierte la demanda en el modo de presentación adecuado." "Java"
				executor = component "Executor" "Aplica el modo planificado sobre la base de conocimiento." "Java"
				knowledgeBase = component "KnowledgeBase" "Mantiene el estado del sistema y carga los umbrales de configuración." "Java"
				multimediaStrategy = component "MultimediaPresentationStrategy" "Presentación multimedia." "Java"
				restrictedStrategy = component "RestrictedPresentationStrategy" "Presentación restringida." "Java"
				textStrategy = component "TextPresentationStrategy" "Presentación en texto." "Java"

				webServer -> controller "Crea y registra el controlador"
				controller -> mapeFacade "Ejecuta el ciclo MAPE-K"
				controller -> contentService "Renderiza el contenido"
				controller -> knowledgeBase "Consulta el estado actual"

				mapeFacade -> monitor "Registra solicitudes"
				mapeFacade -> analyzer "Analiza la demanda"
				mapeFacade -> planner "Planifica la adaptación"
				mapeFacade -> executor "Ejecuta la adaptación"

				monitor -> knowledgeBase "Incrementa el contador de solicitudes"
				analyzer -> knowledgeBase "Lee solicitudes y umbrales"
				executor -> knowledgeBase "Actualiza el modo de presentación"

				contentService -> multimediaStrategy "Usa cuando el modo es MULTIMEDIA"
				contentService -> restrictedStrategy "Usa cuando el modo es RESTRICTED"
				contentService -> textStrategy "Usa cuando el modo es TEXT"
			}
		}

		usuario -> sistema "Navega y consulta el contenido adaptativo" "HTTP"
	}

	views {
		systemContext sistema {
			include usuario
			include sistema
			autolayout lr
		}

		container sistema {
			include usuario
			include webApp
			autolayout lr
		}

		component webApp {
			include *
			autolayout lr
		}

		styles {
			element "Person" {
				shape Person
				background "#0B7285"
				color "#FFFFFF"
			}

			element "Software System" {
				background "#1C7ED6"
				color "#FFFFFF"
			}

			element "Container" {
				background "#E9F2FF"
				color "#0B1F33"
			}

			element "Component" {
				background "#FFF4D6"
				color "#4A3B00"
			}
		}
	}
}