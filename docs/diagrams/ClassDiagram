@startuml
title Taller2PSP - UML Class Diagram (Actualizado)

skinparam packageStyle rectangle
skinparam classAttributeIconSize 0

package app {
	class Main {
		+main(args : String[]) : void
	}
}

package knowledge {
	class KnowledgeBase <<singleton>> {
		-{static} instance : KnowledgeBase
		-state : SystemState
		-config : AdaptationConfig
		-{static} loadConfiguration() : AdaptationConfig
		+{static} getInstance() : KnowledgeBase
		+addRequest() : void
		+reset() : void
		+getRequestCount() : int
		+getCurrentMode() : PresentationMode
		+setCurrentMode(mode : PresentationMode) : void
		+getRestrictedThreshold() : int
		+getTextThreshold() : int
	}

	class SystemState {
		-requestCount : int
		-currentMode : PresentationMode
		+incrementRequestCount() : void
		+reset() : void
		+getRequestCount() : int
		+getCurrentMode() : PresentationMode
		+setCurrentMode(currentMode : PresentationMode) : void
	}

	class AdaptationConfig {
		-restrictedThreshold : int
		-textThreshold : int
		+getRestrictedThreshold() : int
		+getTextThreshold() : int
	}
}

package mape {
	class MapeCycleFacade {
		-knowledge : KnowledgeBase
		-monitor : Monitor
		-analyzer : Analyzer
		-planner : Planner
		-executor : Executor
		+runCycle() : PresentationMode
	}

	class Monitor {
		-knowledge : KnowledgeBase
		+registerRequest() : void
	}

	class Analyzer {
		-knowledge : KnowledgeBase
		+analyzeDemand() : DemandLevel
	}

	class Planner {
		+planAdaptation(demand : DemandLevel) : PresentationMode
	}

	class Executor {
		-knowledge : KnowledgeBase
		+executeAdaptation(plannedMode : PresentationMode) : void
	}
}

package web {
	class Javalin <<external>>
	class Context <<external>>

	class WebServer {
		-knowledge : KnowledgeBase
		-mapeCycleFacade : MapeCycleFacade
		-contentService : ContentService
		+start(port : int) : void
	}

	class ContentController {
		-{static} HTML_UTF8 : String
		-{static} TEXT_UTF8 : String
		-knowledge : KnowledgeBase
		-mapeCycleFacade : MapeCycleFacade
		-contentService : ContentService
		+registerRoutes(app : Javalin) : void
		-getHome(ctx : Context) : void
		-getContent(ctx : Context) : void
		-getStatus(ctx : Context) : void
		-resetSimulation(ctx : Context) : void
		-sendHtml(ctx : Context, html : String) : void
	}
}

package service {
	class ContentService {
		-multimediaStrategy : ContentPresentationStrategy
		-restrictedStrategy : ContentPresentationStrategy
		-textStrategy : ContentPresentationStrategy
		+renderContent(mode : PresentationMode) : String
		-getEducationalContent() : Content
		-selectStrategy(mode : PresentationMode) : ContentPresentationStrategy
	}

	interface ContentPresentationStrategy {
		+render(content : Content) : String
	}

	class MultimediaPresentationStrategy {
		+render(content : Content) : String
		-renderImageCards(content : Content) : String
		-renderVideoCards(content : Content) : String
	}

	class RestrictedPresentationStrategy {
		+render(content : Content) : String
		-renderImageCards(content : Content) : String
	}

	class TextPresentationStrategy {
		+render(content : Content) : String
	}
}

package model {
	class Content {
		-title : String
		-description : String
		-summary : String
		-mainImage : ContentResource
		-mainVideo : ContentResource
		-images : List<ContentResource>
		-videos : List<ContentResource>
		-resourceLink : String
		+getTitle() : String
		+getDescription() : String
		+getSummary() : String
		+getImageDescription() : String
		+getImagePath() : String
		+getVideoDescription() : String
		+getVideoPath() : String
		+getMainImage() : ContentResource
		+getMainVideo() : ContentResource
		+getImages() : List<ContentResource>
		+getVideos() : List<ContentResource>
		+getResourceLink() : String
	}

	class ContentResource {
		-title : String
		-description : String
		-path : String
		+getTitle() : String
		+getDescription() : String
		+getPath() : String
	}

	enum DemandLevel {
		LOW
		MEDIUM
		HIGH
	}

	enum PresentationMode {
		MULTIMEDIA
		RESTRICTED
		TEXT
	}
}

Main --> KnowledgeBase : getInstance()
Main --> Monitor
Main --> Analyzer
Main --> Planner
Main --> Executor
Main --> MapeCycleFacade
Main --> ContentService
Main --> WebServer

KnowledgeBase *-- SystemState
KnowledgeBase *-- AdaptationConfig

WebServer --> ContentController
WebServer --> KnowledgeBase
WebServer --> MapeCycleFacade
WebServer --> ContentService

ContentController --> KnowledgeBase
ContentController --> MapeCycleFacade
ContentController --> ContentService
ContentController --> Javalin
ContentController --> Context

MapeCycleFacade --> KnowledgeBase
MapeCycleFacade --> Monitor
MapeCycleFacade --> Analyzer
MapeCycleFacade --> Planner
MapeCycleFacade --> Executor

Monitor --> KnowledgeBase
Analyzer --> KnowledgeBase
Executor --> KnowledgeBase

Planner --> DemandLevel
Planner --> PresentationMode
Analyzer --> DemandLevel
Executor --> PresentationMode

ContentService --> Content
ContentService --> PresentationMode
ContentService --> ContentPresentationStrategy
ContentPresentationStrategy <|.. MultimediaPresentationStrategy
ContentPresentationStrategy <|.. RestrictedPresentationStrategy
ContentPresentationStrategy <|.. TextPresentationStrategy

Content *-- ContentResource : mainImage
Content *-- ContentResource : mainVideo
Content o-- ContentResource : images
Content o-- ContentResource : videos

' El enum se usa transversalmente en Knowledge, Planner y Controller.
KnowledgeBase --> PresentationMode

@enduml